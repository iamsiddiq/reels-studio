# Shorts/Reels Maker — environment variables
# Copy this file to .env and fill in real values. .env is gitignored.
#
# This product has NO authentication and NO payments — there are
# intentionally no SECRET_KEY / JWT / OAuth variables here.

# --- Database ---
# Used by the backend app (SQLAlchemy) directly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shorts_reels_maker

# Used by the docker-compose `postgres` service to initialize the database.
# Keep these in sync with the credentials embedded in DATABASE_URL above
# when running via docker-compose.
POSTGRES_DB=shorts_reels_maker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Storage ---
# Local directory for downloaded source videos and generated clips.
# Use ./storage for bare-metal/local dev; docker-compose overrides this to
# /app/storage inside the backend container (see docker-compose.yml).
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=500

# --- Video processing ---
FFMPEG_PATH=/usr/bin/ffmpeg
WHISPER_MODEL=base

# --- YouTube downloads ---
# Optional path (inside the backend container) to a Netscape-format
# cookies.txt exported from a logged-in YouTube session. Increasingly
# required on cloud/VPS IPs, which YouTube's bot-check targets heavily --
# downloads that work fine on a residential IP often get blocked without
# this. Leave blank to attempt downloads without cookies.
YT_DLP_COOKIES_FILE=

# --- Highlight selection (OpenAI) ---
# Optional. When set, highlight_detector.py uses OpenAI to semantically pick
# the best moments from the transcript instead of the local word-density
# heuristic. Leave blank to use the heuristic (no API key needed).
# Transcription itself always stays on local faster-whisper either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
