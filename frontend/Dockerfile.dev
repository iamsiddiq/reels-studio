# frontend/Dockerfile.dev
# Development image: runs the Vite dev server with hot module reload instead
# of building static assets for nginx. Used only via docker-compose.dev.yml.

FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
